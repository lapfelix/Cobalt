# Fixture-backed return path. The reader stays in Library and the return is
# followed there rather than on a list of jobs.
clean
tap Library
wait-for My loans
expect Both
tap BAnQ
expect My loans
tap Fixture BAnQ title
wait-for Return this book?
expect BAnQ
tap Keep loan
wait-for My loans
tap Montréal
expect My loans
tap Fixture return title
wait-for Return this book?
expect home server until
tap Return loan
wait-for My loans
clean
wait-for Montréal has it back
clean
